# Password required to ADD / EDIT / REMOVE services and use backups.
# Viewing the dashboard never needs a password. Leave empty (or delete the line) to disable login.
PASSWORD=

# Optional
# PORT=8888
# HOST=0.0.0.0
# CHECK_INTERVAL=30
# DATA_DIR=./data

# Server page (all optional; frp/xray are auto-detected from the running processes)
# OLLAMA_HOST=http://127.0.0.1:11434
# FRP_CONFIG=/path/to/frpc.toml
# FRP_SERVICE=frp
# XRAY_CONFIG=/usr/local/etc/xray/config.json
# XRAY_SERVICE=xray
# XRAY_PROXY=http://127.0.0.1:1081
# XRAY_TEST_URL=https://www.gstatic.com/generate_204
# SYS_SAMPLE_SECONDS=15     # last-hour graphs sampler (0 = off)
# DU_INTERVAL_HOURS=6       # folder-size scan interval on drive tiles (0 = off)
# DU_NETWORK=0              # 1 = also scan network shares (slow)
# SESSION_DAYS=14           # how long a login lasts
